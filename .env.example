# 저장소 루트의 .env로 복사해서 사용합니다. 실제 키는 Git에 올리지 않습니다.
# mock 모드는 외부 API를 호출하지 않으므로 빈칸을 채우지 않아도 실행됩니다.

# DB·원문·색인 저장 폴더. 상대 경로는 저장소 루트 기준입니다.
DATA_DIR=data

# 채팅: mock=테스트 응답, compatible=실제 호환 API 호출.
# 실제 연결 검증 시 compatible로 바꾸고 CHAT_API_KEY를 입력하세요.
CHAT_PROVIDER=mock
# GMS 예제에서 확인한 주소와 모델 ID. 같은 모델을 사용할 때는 그대로 둡니다.
CHAT_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
CHAT_MODEL=gpt-5.4-nano
CHAT_API_KEY=
# GMS_KEY도 사용 가능합니다. 그 경우 위 CHAT_API_KEY 줄을 삭제하세요.

# 임베딩: 문장을 검색용 숫자 벡터로 변환하는 별도 모델입니다.
# 실제 연결은 아래 GMS 설정을 사용하고 compatible로 변경한 뒤 키를 입력하세요.
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=
# 8은 mock 전용 기본값입니다. 위 실제 모델 사용 시 3072로 변경하세요.
EMBEDDING_DIMENSIONS=8

# 외부 API 응답을 기다리는 제한 시간(초).
API_TIMEOUT_SECONDS=30

# RAG 근거가 부족할 때 BGG XML API2의 Rules 포럼을 추가 조회합니다.
# https://boardgamegeek.com/applications 에서 승인된 앱 토큰을 발급받으세요.
# 토큰은 서버 전용입니다. NEXT_PUBLIC_ 변수로 노출하지 마세요. mock 모드는 호출하지 않습니다.
BGG_ENABLED=true
BGG_API_TOKEN=
BGG_TIMEOUT_SECONDS=45

# 규칙 검색 방식: similarity=벡터(기본), hybrid=키워드(BM25)+벡터 RRF, mmr=다양성 비교용.
# 변경 후 API 서버를 재시작합니다. 비교 결과는 reports/stage5-search-comparison.md 참고.
SEARCH_MODE=similarity
