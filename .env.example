# Copy to .env at the repository root. Never commit real keys.
RULE_U_DATA_DIR=data
RULE_U_CHAT_PROVIDER=mock
RULE_U_CHAT_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
RULE_U_CHAT_MODEL=gpt-5.4-nano
RULE_U_CHAT_API_KEY=
# GMS_KEY is also accepted for chat, as in streamlit_lab.
# Embedding support/model/dimension must be confirmed separately.
RULE_U_EMBEDDING_PROVIDER=mock
RULE_U_EMBEDDING_BASE_URL=
RULE_U_EMBEDDING_MODEL=
RULE_U_EMBEDDING_API_KEY=
RULE_U_EMBEDDING_DIMENSIONS=8
RULE_U_API_TIMEOUT_SECONDS=30
