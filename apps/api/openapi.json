            "type": "string",
            "title": "Id"
          },
          "name_ko": {
            "type": "string",
            "title": "Name Ko"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "min_players": {
            "type": "integer",
            "title": "Min Players"
          },
          "max_players": {
            "type": "integer",
            "title": "Max Players"
          },
          "rules_supported": {
            "type": "boolean",
