          },
          "min_players": {
            "type": "integer",
            "title": "Min Players"
          },
          "max_players": {
            "type": "integer",
            "title": "Max Players"
          },
          "rules_supported": {
            "type": "boolean",
            "title": "Rules Supported",
            "default": false
          },
          "min_minutes": {
            "type": "integer",
            "title": "Min Minutes",
            "default": 0
          },
          "max_minutes": {
            "type": "integer",
            "title": "Max Minutes",
            "default": 0
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "source_review": {
            "type": "string",
            "title": "Source Review",
            "default": "unverified"
          },
          "editions": {
            "items": {
              "$ref": "#/components/schemas/EditionOut"
            },
            "type": "array",
            "title": "Editions"
          },
          "expansions": {
            "items": {
              "$ref": "#/components/schemas/ExpansionOut"
            },
            "type": "array",
            "title": "Expansions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name_ko",
          "description",
          "min_players",
          "max_players",
          "editions",
          "expansions"
        ],
        "title": "GameDetail"
      },
      "GameList": {
