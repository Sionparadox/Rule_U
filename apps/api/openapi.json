  "components": {
    "schemas": {
      "AnswerOut": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Citations"
          },
          "citation_notice": {
            "type": "string",
            "title": "Citation Notice",
            "default": "\uc774 \ub2f5\ubcc0\uc5d0 \uc778\uc6a9\ub41c \uadfc\uac70\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "type": "object",
        "required": [
          "answer",
          "verdict"
        ],
        "title": "AnswerOut"
      },
      "BookmarkIn": {
        "properties": {
          "saved": {
            "type": "boolean",
            "title": "Saved"
          }
        },
        "type": "object",
        "required": [
          "saved"
        ],
        "title": "BookmarkIn"
      },
      "BookmarkOut": {
        "properties": {
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "saved": {
            "type": "boolean",
            "title": "Saved"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "saved"
        ],
        "title": "BookmarkOut"
      },
      "ConversationCreated": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          }
        },
        "type": "object",
        "required": [
          "conversation_id"
        ],
        "title": "ConversationCreated"
      },
      "ConversationIn": {
        "properties": {
          "game_id": {
            "type": "string",
            "title": "Game Id"
          },
          "edition_id": {
            "type": "string",
            "title": "Edition Id"
          },
          "expansion_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Expansion Ids"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "edition_id"
        ],
        "title": "ConversationIn"
      },
      "ConversationOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "game_id": {
            "type": "string",
            "title": "Game Id"
          },
          "edition_id": {
            "type": "string",
            "title": "Edition Id"
          },
          "expansion_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Expansion Ids"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "type": "array",
            "title": "Messages"
          },
          "active_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Request Id"
          },
          "latest_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Request Id"
          },
          "latest_client_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Client Request Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "game_id",
          "edition_id",
          "expansion_ids",
          "messages"
        ],
        "title": "ConversationOut"
      },
      "EditionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "supported": {
            "type": "boolean",
            "title": "Supported"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "language",
          "supported"
        ],
        "title": "EditionOut"
      },
      "ExpansionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "supported": {
            "type": "boolean",
            "title": "Supported"
          },
          "edition_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Edition Ids"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "supported"
        ],
        "title": "ExpansionOut"
      },
      "FeedbackIn": {
        "properties": {
          "rating": {
            "type": "string",
            "enum": [
              "helpful",
              "wrong"
            ],
            "title": "Rating"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "rule_differs",
                  "wrong_page",
                  "missing_info",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "rating"
        ],
        "title": "FeedbackIn"
      },
      "FeedbackOut": {
        "properties": {
          "rating": {
            "type": "string",
            "enum": [
              "helpful",
              "wrong"
            ],
            "title": "Rating"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "rule_differs",
                  "wrong_page",
                  "missing_info",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "rating"
        ],
        "title": "FeedbackOut"
      },
      "GameDetail": {
        "properties": {
          "id": {
            "type": "string",
