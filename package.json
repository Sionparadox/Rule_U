{
  "name": "rule-u",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev:web": "corepack pnpm --filter @rule-u/web dev",
    "build": "corepack pnpm --filter @rule-u/web build",
    "typecheck": "corepack pnpm --filter @rule-u/web typecheck",
    "types:api": "corepack pnpm --filter @rule-u/web types:api",
    "test:e2e": "playwright test",
    "lint": "corepack pnpm --filter @rule-u/web lint",
    "format:check": "corepack pnpm --filter @rule-u/web format:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
